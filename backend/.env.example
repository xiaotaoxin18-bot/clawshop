# ============================================
# clawshop 环境变量配置
# 复制此文件为 .env 后按需修改
# cp .env.example .env
# ============================================

# ---- 服务器 ----
SERVER_PORT=3000
SERVER_HOST=localhost
SUDA_DATABASE_URL=postgresql://appuser:app123456@localhost:5432/inventory_db?schema=workspace_aadkeahc42wbs

# ---- 前端开发端口（仅开发模式） ----
CLIENT_DEV_PORT=8080

# ---- 飞书平台（本地开发必须设置） ----
FORCE_AUTHN_INNERAPI_DOMAIN=localhost:3000

# ---- 日志 ----
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ---- 管理员密码（用于"个人管理"页一键清除数据） ----
ADMIN_CLEAR_PASSWORD=admin123

# ---- 飞书集成（可选，用于同步数据到飞书多维表格） ----
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret
